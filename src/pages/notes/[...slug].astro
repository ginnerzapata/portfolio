---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() { const notes = await getCollection("notes", ({ data }) => !data.draft); return notes.map((note) => ({ params: { slug: note.id }, props: { note } })); }
const { note } = Astro.props;
const { Content } = await render(note);
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title={`${note.data.title} | Ginner Zapata`} description={note.data.description}>
  <main class="note-page" id="main-content"><a href={`${baseUrl}notes/`} class="back-link">&#8592; Notes</a><article><p class="eyebrow">{note.data.tags.join(" / ")}</p><h1>{note.data.title}</h1><p class="description">{note.data.description}</p><time datetime={note.data.publishedAt.toISOString()}>{note.data.publishedAt.toLocaleDateString("en", { day: "numeric", month: "long", year: "numeric" })}</time><div class="article-content"><Content /></div></article></main>
</BaseLayout>
<style>
  .note-page { margin: 0 auto; max-width: 760px; padding: var(--space-16) var(--space-5); } .back-link, .eyebrow, time { color: var(--color-text-muted); font-size: var(--font-size-small); } .back-link { display: inline-block; margin-bottom: var(--space-16); text-underline-offset: var(--space-1); } .eyebrow { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; } h1 { font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: -0.07em; line-height: var(--line-height-tight); margin: var(--space-3) 0 var(--space-6); } .description { color: var(--color-text-muted); font-size: 1.25rem; line-height: var(--line-height-body); margin-bottom: var(--space-4); } .article-content { border-top: 1px solid var(--color-border); font-size: 1.125rem; line-height: 1.7; margin-top: var(--space-10); padding-top: var(--space-8); } .article-content :global(h2) { font-size: 1.75rem; letter-spacing: -0.04em; line-height: 1.1; margin: var(--space-10) 0 var(--space-4); } .article-content :global(a) { color: inherit; text-underline-offset: var(--space-1); } .article-content :global(pre) { background: var(--neutral-950); color: var(--neutral-0); overflow-x: auto; padding: var(--space-5); }
</style>
