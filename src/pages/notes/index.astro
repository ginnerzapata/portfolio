---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Notes | Ginner Zapata" description="Technical notes by Ginner Zapata.">
  <main class="notes-page" id="main-content"><a href={baseUrl} class="back-link">&#8592; Home</a><p class="eyebrow">Notes</p><h1>Things I am learning in public.</h1>{notes.length > 0 ? <ul class="note-list">{notes.map((note) => <li><a href={`${baseUrl}notes/${note.id}/`}><time datetime={note.data.publishedAt.toISOString()}>{note.data.publishedAt.toLocaleDateString("en", { month: "short", year: "numeric" })}</time><h2>{note.data.title}</h2><p>{note.data.description}</p></a></li>)}</ul> : <p class="empty-state">Notes will appear here when they are ready.</p>}</main>
</BaseLayout>
<style>
  .notes-page { margin: 0 auto; max-width: 880px; padding: var(--space-16) var(--space-5); } .back-link, .eyebrow, time { color: var(--color-text-muted); font-size: var(--font-size-small); } .back-link { display: inline-block; margin-bottom: var(--space-16); text-underline-offset: var(--space-1); } .eyebrow { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; } h1 { font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: -0.07em; line-height: var(--line-height-tight); margin: var(--space-3) 0 var(--space-16); } .note-list { list-style: none; margin: 0; padding: 0; } .note-list li { border-top: 1px solid var(--color-border); } .note-list a { color: var(--color-text-primary); display: block; padding: var(--space-6) 0; text-decoration: none; } .note-list h2 { font-size: var(--font-size-title); margin: var(--space-2) 0; } .note-list p, .empty-state { color: var(--color-text-muted); line-height: var(--line-height-body); margin: 0; }
</style>
