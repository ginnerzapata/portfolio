---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const experience = [
  { company: "Vizzn", role: "Senior Web Developer", period: "Aug 2025 - Present", details: ["Develop production React and TypeScript applications with a focus on usability, performance, and maintainability.", "Partner with product managers and backend engineers across the product lifecycle while improving frontend architecture."] },
  { company: "Elys Network", role: "Frontend Developer", period: "Nov 2024 - Aug 2025", details: ["Translated complex Figma designs into pixel-accurate, responsive React and Next.js interfaces.", "Built low-latency real-time market-data experiences using Redis, Server-Sent Events, and WebSockets."] },
  { company: "Vizzn", role: "Frontend Developer", period: "Dec 2020 - Nov 2024", details: ["Designed and developed production web applications in close partnership with product, design, and backend teams.", "Led experience redesigns and improved maintainability through component refactoring, performance work, and authentication migrations."] },
];
---
<BaseLayout>
  <main id="main-content" class="page-shell">
    <div class="page-frame" id="top">
      <SiteHeader />
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">Ginner Zapata / Frontend Engineer</p>
        <h1 id="hero-title">Frontend Engineer.<br />building <em>fast, polished</em><br />product experiences.</h1>
        <p class="hero-summary">I build complex interfaces, real-time products and frontend systems with a focus on performance, usability and maintainability.</p>
        <a class="button button-primary" href="#contact"><span class="button-content">Get in touch <span aria-hidden="true">&#8594;</span></span></a>
      </section>
      <section class="content-section" id="experience" aria-labelledby="experience-title">
        <div class="section-intro"><p class="eyebrow">01 / Experience</p><h2 id="experience-title">A record of building products that need to work.</h2></div>
        <ol class="experience-list">{experience.map((entry) => <li class="experience-entry"><div class="experience-meta"><p>{entry.company}</p><p>{entry.period}</p></div><div class="experience-content"><h3>{entry.role}</h3><ul>{entry.details.map((detail) => <li>{detail}</li>)}</ul></div></li>)}</ol>
      </section>
      <section class="content-section" id="about" aria-labelledby="about-title">
        <div class="section-intro"><p class="eyebrow">02 / About</p><h2 id="about-title">Careful systems. Clear interfaces.</h2></div>
        <div class="prose"><p>I am a frontend developer working remotely from Rio de Janeiro. I build scalable web applications for international startups and SaaS companies, turning ambitious product requirements and detailed design work into responsive, production-ready interfaces.</p><p>My practice sits at the intersection of frontend architecture, UI implementation, and product judgment. I enjoy working closely with design, product, and backend teams to make complex software feel direct and dependable. Right now, I am learning Go.</p></div>
      </section>
      <section class="content-section contact-section" id="contact" aria-labelledby="contact-title">
        <p class="eyebrow">03 / Contact</p><h2 id="contact-title">Have a product worth making clearer?</h2>
        <div class="contact-actions"><a class="button button-primary" href="mailto:ginnerzapata@gmail.com"><span class="button-content">Email me <span aria-hidden="true">&#8594;</span></span></a><a class="text-link" href="https://github.com/ginnerzapata" rel="me external">GitHub</a></div>
      </section>
      <SiteFooter />
    </div>
  </main>
</BaseLayout>
<style>
  .page-frame { margin: 0 auto; max-width: 1600px; padding: 0 var(--space-12); }
  .hero { align-content: center; display: grid; min-height: calc(100svh - var(--space-20)); padding: var(--space-16) 10.5% var(--space-20); }
  .eyebrow { color: var(--color-text-muted); font-size: var(--font-size-small); font-weight: 600; letter-spacing: 0.06em; margin: 0 0 var(--space-6); text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { font-size: var(--font-size-display); font-weight: 750; letter-spacing: -0.075em; line-height: var(--line-height-tight); margin-bottom: var(--space-10); }
  h1 em { color: var(--color-text-muted); font-weight: 450; }
  .hero-summary { color: var(--color-text-muted); font-size: clamp(1rem, 1.4vw, 1.25rem); line-height: var(--line-height-body); margin-bottom: var(--space-8); max-width: 60ch; }
  .button { align-items: center; display: inline-flex; font-size: var(--font-size-body); font-weight: 600; isolation: isolate; justify-content: center; min-height: 52px; overflow: hidden; padding: var(--space-3) var(--space-5); position: relative; text-decoration: none; width: fit-content; }
  .button-primary { background: var(--color-action); border: 1px solid var(--color-action); color: var(--color-action-text); }
  .button-primary::before { background: var(--color-surface-raised); content: ""; inset: 0; position: absolute; transform: translateX(-101%); transition: transform 320ms var(--ease-out); z-index: 0; }
  .button-content { align-items: center; display: inline-flex; gap: var(--space-4); position: relative; transition: transform 320ms var(--ease-out); z-index: 1; }
  .button-primary:hover, .button-primary:focus-visible { color: var(--color-text-primary); }
  .button-primary:hover::before, .button-primary:focus-visible::before { transform: translateX(0); }
  .button-primary:hover .button-content, .button-primary:focus-visible .button-content { transform: translateX(var(--space-1)); }
  .content-section { border-top: 1px solid var(--color-border); display: grid; gap: var(--space-12); grid-template-columns: 4fr 8fr; padding: var(--space-24) 10.5%; scroll-margin-top: var(--space-6); }
  .section-intro h2, .contact-section h2 { font-size: clamp(2rem, 3.2vw, 3.5rem); letter-spacing: -0.06em; line-height: 1; margin-bottom: 0; max-width: 12ch; }
  .experience-list { list-style: none; margin: 0; padding: 0; }
  .experience-entry { border-top: 1px solid var(--color-border); display: grid; gap: var(--space-8); grid-template-columns: minmax(140px, 1fr) 2fr; padding: var(--space-6) 0; }
  .experience-entry:last-child { border-bottom: 1px solid var(--color-border); }
  .experience-meta p, .experience-content li, .prose p { color: var(--color-text-muted); font-size: var(--font-size-body); line-height: var(--line-height-body); }
  .experience-meta p { margin-bottom: var(--space-1); }
  .experience-content h3 { font-size: var(--font-size-title); letter-spacing: -0.03em; margin-bottom: var(--space-4); }
  .experience-content ul { margin: 0; padding-left: var(--space-5); } .experience-content li + li { margin-top: var(--space-2); }
  .prose { max-width: 62ch; } .prose p { font-size: clamp(1.125rem, 1.5vw, 1.375rem); margin-bottom: var(--space-6); }
  .contact-section { display: block; } .contact-section h2 { margin-bottom: var(--space-8); max-width: 15ch; }
  .contact-actions { align-items: center; display: flex; flex-wrap: wrap; gap: var(--space-6); }
  .text-link { color: var(--color-text-primary); font-size: var(--font-size-body); font-weight: 600; text-underline-offset: var(--space-1); }
  @media (max-width: 900px) { .content-section { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .page-frame { padding: 0 var(--space-5); } .hero { min-height: calc(100svh - var(--space-20)); padding: var(--space-12) 0 var(--space-16); } h1 { letter-spacing: -0.07em; line-height: 1.04; } .content-section { gap: var(--space-8); padding: var(--space-16) 0; } .experience-entry { gap: var(--space-4); grid-template-columns: 1fr; } }
</style>
